# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — real keys never go in git.

# ── Claude (console.anthropic.com → API Keys). Also set a monthly spend limit there.
ANTHROPIC_API_KEY=
# Optional override. Default: claude-opus-5 (Anthropic's current recommendation).
# CLAUDE_MODEL=claude-sonnet-5

# ── Voyage AI (dash.voyageai.com → API Keys) — embeddings + reranking
VOYAGE_API_KEY=

# ── Supabase (your dedicated project → Project Settings)
# API Keys page → Project URL + a *secret* key (server-only; never shipped to browsers)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Database → Connect → "Session pooler" connection string (used only by `npm run db:migrate`)
DATABASE_URL=

# ── Which folder to ingest. "data" = your real documents, "sample-data" = the fictional demo brand.
DATA_DIR=data

# ── Who customers are sent to when the assistant can't answer (kept out of the public repo).
CONTACT_PHONE=
CONTACT_EMAIL=

# ── Tuning (optional)
# Minimum reranker score (0–1) for a chunk to count as relevant. Below this for every chunk
# (and no fitment match) → the assistant escalates without calling Claude.
# RELEVANCE_THRESHOLD=0.3

# ── Never ingest files whose path contains any of these (comma-separated, case-insensitive).
# Belt-and-braces on top of exclude=true in manifest.csv.
INGEST_BLOCKLIST=differentiators
